{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT n.key, n.name, n.node_type\n        FROM node n\n        WHERE n.archived_at IS NULL\n          AND ($1 OR n.node_type = 'project')\n          AND ($2::uuid[] IS NULL OR n.id = ANY($2))\n          AND (lower(n.key) LIKE $3 OR lower(n.name) LIKE $4)\n        ORDER BY n.key\n        LIMIT $5\n        ",
