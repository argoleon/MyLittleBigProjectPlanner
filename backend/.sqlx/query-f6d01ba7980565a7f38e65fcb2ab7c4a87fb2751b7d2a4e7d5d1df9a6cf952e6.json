{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT a.id, a.display_name, a.email\n        FROM membership m\n        JOIN account a ON a.id = m.account_id\n        WHERE m.status = 'active'\n          AND ($1::text IS NULL OR lower(a.display_name) LIKE $1 OR a.email LIKE $1)\n        ORDER BY lower(a.display_name), a.id\n        LIMIT $2\n        ",
