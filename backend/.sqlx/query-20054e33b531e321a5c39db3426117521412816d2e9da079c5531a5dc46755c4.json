{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT a.id AS account_id, a.email, a.display_name\n        FROM group_member gm\n        JOIN account a ON a.id = gm.account_id\n        WHERE gm.group_id = $1\n        ORDER BY lower(a.display_name), a.id\n        ",
