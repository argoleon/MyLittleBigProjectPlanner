  "query": "\n        SELECT sg.filter_id, g.id, g.name\n        FROM saved_filter_group sg JOIN \"group\" g ON g.id = sg.group_id\n        WHERE sg.filter_id = ANY($1)\n        ORDER BY lower(g.name), g.id\n        ",
