  "query": "\n        SELECT c.id, c.kind, c.name AS \"name: Json<BTreeMap<String, String>>\", c.holiday_set, c.version,\n               (SELECT count(*) FROM resource r WHERE r.calendar_id = c.id) AS \"resource_count!\"\n        FROM calendar c\n        ORDER BY c.kind = 'site', c.created_at, c.id\n        ",
