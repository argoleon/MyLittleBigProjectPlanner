  "query": "\n        SELECT i.id, i.email, i.account_type, i.tenant_role, i.status, i.expires_at,\n               a.display_name AS \"invited_by_name?\", i.version, i.created_at\n        FROM invitation i\n        LEFT JOIN account a ON a.id = i.invited_by\n        WHERE i.id = $1\n        ",
