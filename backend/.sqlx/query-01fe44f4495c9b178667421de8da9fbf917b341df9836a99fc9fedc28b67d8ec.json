{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT o.node_id, a.id AS account_id, a.display_name\n        FROM node_owner o\n        JOIN account a ON a.id = o.account_id\n        WHERE o.node_id = ANY($1)\n        ORDER BY a.display_name, a.id\n        ",
