  "query": "\n        SELECT DISTINCT ON (f.item_id) f.item_id, f.key, f.kind, f.options\n        FROM field_def f\n        JOIN project_config_version v ON v.id = f.version_id AND v.state = 'published'\n        WHERE f.key = ANY($1)\n        ORDER BY f.item_id\n        ",
