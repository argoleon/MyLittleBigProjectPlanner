{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT e.child_id, p.id, p.node_type, p.name\n        FROM node_edge e\n        JOIN node p ON p.id = e.parent_id\n        WHERE e.child_id = ANY($1)\n        ORDER BY p.name, p.id\n        ",
