  "query": "\n        SELECT id, code, label AS \"label: Json<BTreeMap<String, String>>\",\n               quantity, version, created_at, updated_at\n        FROM reference_item\n        WHERE ($1::timestamptz IS NULL OR (created_at, id) > ($1, $2::uuid))\n        ORDER BY created_at, id\n        LIMIT $3\n        ",
