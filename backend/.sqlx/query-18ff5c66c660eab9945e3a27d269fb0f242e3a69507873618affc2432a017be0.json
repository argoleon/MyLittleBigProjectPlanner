{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT i.id, i.status_id, i.type_id\n        FROM issue i\n        WHERE i.project_id IN (SELECT n.id FROM node n WHERE n.config_id = $1)\n          AND (i.status_id = ANY($2) OR i.type_id = ANY($3))\n        ORDER BY i.id\n        LIMIT $4\n        FOR UPDATE OF i\n        ",
