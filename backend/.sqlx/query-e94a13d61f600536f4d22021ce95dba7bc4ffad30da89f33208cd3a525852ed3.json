  "db_name": "PostgreSQL",
  "query": "\n        SELECT i.id, i.key, i.summary, n.id AS project_id, n.key AS \"project_key!\", n.name AS project_name,\n               n.archived_at IS NOT NULL AS \"archived!\"\n        FROM issue i JOIN node n ON n.id = i.project_id\n        WHERE i.id = ANY($1)\n        ",
