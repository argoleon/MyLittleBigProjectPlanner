  "query": "\n        UPDATE node\n        SET archived_at = CASE WHEN $3 THEN coalesce(archived_at, now()) END, version = version + 1\n        WHERE id = $1 AND ($2::bigint[] IS NULL OR version = ANY($2))\n        RETURNING id\n        ",
