  "query": "\n        SELECT tm.resource_id, t.id, t.name AS \"name: Json<BTreeMap<String, String>>\"\n        FROM team_member tm\n        JOIN team t ON t.id = tm.team_id\n        WHERE tm.resource_id = ANY($1)\n        ORDER BY t.created_at, t.id\n        ",
