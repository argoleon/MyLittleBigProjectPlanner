{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT p.id, p.node_type, p.name, p.key, e.weight_percent, p.confidential\n        FROM node_edge e JOIN node p ON p.id = e.parent_id\n        WHERE e.child_id = $1\n        ORDER BY p.name, p.id\n        ",
