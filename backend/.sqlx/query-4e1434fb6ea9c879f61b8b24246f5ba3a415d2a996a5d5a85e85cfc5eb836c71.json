  "query": "\n        SELECT a.id, a.display_name\n        FROM membership m JOIN account a ON a.id = m.account_id\n        WHERE m.status = 'active' AND a.id = ANY($1)\n        ORDER BY lower(a.display_name), a.id\n        ",
