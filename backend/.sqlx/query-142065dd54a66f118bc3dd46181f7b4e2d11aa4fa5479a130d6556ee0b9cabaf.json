  "query": "\n        SELECT i.status_id, i.type_id, count(*) AS \"count!\"\n        FROM issue i\n        WHERE i.project_id IN (SELECT n.id FROM node n WHERE n.config_id = $1)\n        GROUP BY i.status_id, i.type_id\n        ",
