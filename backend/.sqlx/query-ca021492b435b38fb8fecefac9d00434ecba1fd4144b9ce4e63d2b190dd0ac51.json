  "query": "\n        SELECT resource_id, day, sum(minutes)::integer AS \"minutes!\"\n        FROM resource_day_load\n        WHERE resource_id = ANY($1) AND day BETWEEN $2 AND $3 AND ($4 OR NOT provisional)\n        GROUP BY resource_id, day\n        ",
