  "query": "\n        SELECT gm.account_id, g.id, g.name\n        FROM group_member gm\n        JOIN \"group\" g ON g.id = gm.group_id\n        WHERE gm.account_id = ANY($1)\n        ORDER BY lower(g.name), g.id\n        ",
