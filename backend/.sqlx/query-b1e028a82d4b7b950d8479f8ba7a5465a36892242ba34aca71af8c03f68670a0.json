  "query": "\n        SELECT resource_id, kind, start_date, starts_at_noon, end_date, ends_at_noon\n        FROM absence\n        WHERE resource_id = ANY($1) AND start_date <= $3 AND end_date >= $2\n        ORDER BY start_date, id\n        ",
