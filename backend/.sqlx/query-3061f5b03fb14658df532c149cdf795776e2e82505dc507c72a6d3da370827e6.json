  "query": "\n        SELECT c.id, c.node_type, c.name, c.key, e.weight_percent\n        FROM node_edge e JOIN node c ON c.id = e.child_id\n        WHERE e.parent_id = $1\n        ORDER BY c.name, c.id\n        ",
