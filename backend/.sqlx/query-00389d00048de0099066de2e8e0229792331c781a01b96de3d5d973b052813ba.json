  "query": "\n        SELECT object_key, thumbnail_key, served_type AS \"served_type!\"\n        FROM attachment\n        WHERE sha256 = $1 AND status = 'clean' AND id <> $2\n        ORDER BY created_at, id\n        LIMIT 1\n        ",
