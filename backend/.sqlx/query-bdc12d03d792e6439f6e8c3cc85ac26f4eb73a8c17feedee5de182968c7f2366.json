  "query": "\n        SELECT a.id, a.email, a.display_name, a.locale, a.password_hash,\n               m.account_type, m.tenant_role, m.status, m.local_account\n        FROM account a\n        JOIN membership m ON m.account_id = a.id\n        WHERE a.email = $1\n        ",
