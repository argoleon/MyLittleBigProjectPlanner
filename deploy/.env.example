# Configuration of My Little Big Project Planner. Copy to deploy/.env and
# adjust. Never commit deploy/.env. Documentation: deploy/README.md.
#
# Two kinds of variables:
#
# - Stack variables (first section) are read by deploy/compose.yaml.
# - Service variables (other sections) are read by the api, worker and mcp
#   binaries. compose.yaml already sets them for its containers, with
#   secrets read from files; they are listed here to run the binaries
#   elsewhere (Kubernetes, bare metal) and to tune the defaults.
#
# Any service variable can instead be read from a mounted file: set
# NAME_FILE to the file path rather than NAME (e.g.
# DATABASE_URL_FILE=/run/secrets/database_url). Setting both NAME and
# NAME_FILE is an error. Secrets have no default and are never put here:
# they live in deploy/secrets/ (deploy/scripts/generate-secrets.sh).

# === Stack (deploy/compose.yaml) ============================================

# Public domain name. Required.
MLBPP_DOMAIN=planner.example.org

# Contact email of the Let's Encrypt account (expiry notices). Recommended.
ACME_EMAIL=admin@example.org

# Registry and version of the images. Default: ghcr.io/argoleon, latest.
# Pin a release in production, e.g. MLBPP_VERSION=v0.1.0.
# MLBPP_REGISTRY=ghcr.io/argoleon
# MLBPP_VERSION=latest

# Ports published by Traefik. Default: 80 and 443
# HTTP_PORT=80
# HTTPS_PORT=443

# Traefik rule replacing the default host rule of every public route:
# MLBPP_DOMAIN and its subdomains. Default: unset
# MLBPP_HOST_RULE=Host(`planner.example.org`)

# Port appended to public URLs built by Keycloak and Grafana, when not 443
# (e.g. :8443). Default: empty
# MLBPP_PUBLIC_PORT=

# Backups (pgBackRest, service "backup"): daily at BACKUP_TIME (UTC), full on
# BACKUP_FULL_DAY (1 = Monday … 7 = Sunday), incremental the other days;
# BACKUP_RETENTION_FULL full backups kept. Defaults: 02:00, 7, 4
# BACKUP_TIME=02:00
# BACKUP_FULL_DAY=7
# BACKUP_RETENTION_FULL=4

# Maximum seconds between two archived WAL segments: bounds the data loss
# between backups. Default: 300
# POSTGRES_ARCHIVE_TIMEOUT=300

# Retention of the metrics (profile "observability"). Default: 15d
# PROMETHEUS_RETENTION=15d

# === Service variables ======================================================

# --- All services -----------------------------------------------------------

# Log filter (tracing EnvFilter syntax). Default: info
# RUST_LOG=info,api=debug

# Seconds given to in-flight requests or jobs after SIGTERM. Default: 30
# SHUTDOWN_GRACE_SECS=30

# --- Database (api, later worker) -------------------------------------------

# Connection URL of the runtime role mlbpp_app (not owner, no BYPASSRLS). Required. Secret:
# prefer DATABASE_URL_FILE=/run/secrets/database_url.
DATABASE_URL=postgres://mlbpp_app:<password>@postgres:5432/mlbpp

# Connection URL of the owner role mlbpp_owner. Optional. When set, the api
# applies pending migrations at startup; otherwise run `api migrate` as a job.
# DATABASE_MIGRATION_URL=postgres://mlbpp_owner:<password>@postgres:5432/mlbpp

# Maximum pooled connections per service instance. Default: 10
# DATABASE_MAX_CONNECTIONS=10

# Seconds to wait for a free pooled connection before failing. Default: 5
# DATABASE_ACQUIRE_TIMEOUT_SECS=5

# --- Tenancy (api) ----------------------------------------------------------

# single: one tenant whatever the host name; multi: one subdomain per tenant. Default: single
# TENANCY_MODE=single

# Single mode: slug of the tenant served. Default: default
# TENANT_DEFAULT_SLUG=default

# Multi mode: base domain; acme.example.org serves the tenant "acme". Required in multi mode.
# TENANT_BASE_DOMAIN=example.org

# --- api --------------------------------------------------------------------

# Address and port the API listens on. Required.
API_BIND_ADDR=0.0.0.0:8080

# Maximum duration of a request, in seconds; answers 408 beyond. Default: 30
# API_REQUEST_TIMEOUT_SECS=30

# Maximum request body size, in bytes; answers 413 beyond. Default: 2097152 (2 MiB)
# Attachments do not go through the API (presigned URLs), so this stays small.
# API_BODY_LIMIT_BYTES=2097152

# --- worker -----------------------------------------------------------------

# Pause between two polls of an empty job queue, in milliseconds. Default: 1000
# WORKER_POLL_INTERVAL_MS=1000

# Address and port of the worker's health endpoint (/health/live), its only
# HTTP endpoint. Default: 0.0.0.0:8081
# WORKER_HEALTH_ADDR=0.0.0.0:8081

# --- mcp --------------------------------------------------------------------

# Address and port the MCP server listens on. Required.
MCP_BIND_ADDR=0.0.0.0:8090

# Base URL of the public API the MCP server calls. Required.
MCP_API_BASE_URL=http://api:8080
